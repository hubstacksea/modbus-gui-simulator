/* config.h for libmodbus generated by CMake (modbus_gui) */
#ifndef LIBMODBUS_CONFIG_H
#define LIBMODBUS_CONFIG_H

#cmakedefine HAVE_ARPA_INET_H 1
#cmakedefine HAVE_NETINET_IN_H 1
#cmakedefine HAVE_NETINET_IP_H 1
#cmakedefine HAVE_SYS_SOCKET_H 1
#cmakedefine HAVE_UNISTD_H 1
#cmakedefine HAVE_TERMIOS_H 1
#cmakedefine HAVE_LINUX_SERIAL_H 1
#cmakedefine HAVE_ACCEPT4 1
#cmakedefine HAVE_GETADDRINFO 1
#cmakedefine HAVE_GAI_STRERROR 1
#cmakedefine HAVE_STRLCPY 1
#cmakedefine HAVE_WINSOCK2_H 1

#define HAVE_DECL_TIOCSRS485 @HAVE_DECL_TIOCSRS485@
#define HAVE_DECL_TIOCM_RTS @HAVE_DECL_TIOCM_RTS@

#define HAVE_ERRNO_H 1
#define HAVE_FCNTL_H 1
#define HAVE_LIMITS_H 1
#define HAVE_STDINT_H 1
#define HAVE_STDLIB_H 1
#define HAVE_STRING_H 1
#define HAVE_TIME_H 1

#define PACKAGE "libmodbus"
#define PACKAGE_VERSION "@LIBMODBUS_VERSION@"
#define VERSION "@LIBMODBUS_VERSION@"

#endif
